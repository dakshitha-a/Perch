# Perch v1 worker (brief, Scout, cover-point and hand-off jobs) as a systemd unit.
# It loads the embedder, reranker and MiniCheck on one GPU. scripts/run_limited.sh pins it to
# PERCH_LIMIT_GPU, caps its CPU cores and holds a lock so only one GPU job runs on that card.
# For the no-GPU fallback, drop PERCH_LIMIT_GPU and set the cloud-cpu profile in perch.env.
# Install as for perch-web.service; start it after the web process has migrated the database.
[Unit]
Description=Perch v1 worker
After=network-online.target perch-web.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/perch
EnvironmentFile=/etc/perch/perch.env
Environment=PERCH_LIMIT_GPU=0
ExecStart=/bin/sh -c 'PERCH_DATABASE_URL="$${PERCH_WORKER_DATABASE_URL}" exec /opt/perch/scripts/run_limited.sh /opt/perch/.venv/bin/perch worker'
Restart=on-failure
RestartSec=30
TimeoutStopSec=60
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
