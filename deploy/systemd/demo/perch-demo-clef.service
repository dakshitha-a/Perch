# Perch demo (deploy-2gpu), GPU B: Clef, validator layer 2, port 8094.
# Rendered and installed by `make demo`; a systemd user unit.
[Unit]
Description=Perch demo grounding model Clef (llama.cpp, GPU @GPU_B@, port 8094)
After=network-online.target

[Service]
Environment=CUDA_VISIBLE_DEVICES=@GPU_B@
ExecStart=%h/.local/bin/llama serve -hf bartowski/Cloudflare_clef-GGUF:Q4_K_M --port 8094 -ngl 99 -ub 4096 -b 4096 --host 127.0.0.1
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
