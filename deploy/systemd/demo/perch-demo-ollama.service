# Perch demo (deploy-2gpu), GPU A: Ollama with the chat model, port 11437, 8k context.
# Rendered and installed by `make demo` (@GPU_A@ is DEMO_GPU_A); a systemd user unit.
[Unit]
Description=Perch demo chat model (Ollama, GPU @GPU_A@, port 11437)
After=network-online.target

[Service]
Environment=CUDA_VISIBLE_DEVICES=@GPU_A@
Environment=OLLAMA_HOST=127.0.0.1:11437
Environment=OLLAMA_MODELS=/usr/share/ollama/.ollama/models
Environment=OLLAMA_NOPRUNE=1
# 12,288 with two slots measured on GPU 4 (S31, F28): 20,038 MiB peak, +176 MiB over 8,192;
# with Clef-flash (8,012 MiB) about 28,050 MiB of 32,760 on this card. No truncation up to 11,120 tokens.
Environment=OLLAMA_CONTEXT_LENGTH=12288
Environment=OLLAMA_KEEP_ALIVE=-1
# Two parallel slots (S30 P1 measurement on GPU 4: explanations 32.3 s with 1, 27.0 s with 2;
# peak VRAM 19.9 GB with 2, about 27.3 GB on this card with Clef-flash). Applied at the S32 rebuild.
Environment=OLLAMA_NUM_PARALLEL=2
ExecStart=/usr/local/bin/ollama serve
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
