# .env.example — every environment variable Perch reads, with a comment.
# Copy to .env (gitignored) and fill in. Secrets live only in .env, never in
# code, tests, fixtures, logs or commit messages. The repo will be public.

# Anthropic API key for the hosted model tier (perch/llm/ reads it from S5 on).
ANTHROPIC_API_KEY=
# Hard cap on total Anthropic spend, in USD, enforced by the adapter from its ledger
# (data/logs/anthropic_spend.jsonl). Calls are refused at the cap.
PERCH_ANTHROPIC_BUDGET_USD=100
# Model per role: <adapter>:<model>, adapters ollama, openai, anthropic, fake.
# Roles: PROFILE_SUMMARY, FIT_EXPLAINER, HANDOFF, SCOUT, DECIDE. Default: the chat model
# of PERCH_PROFILE (perch/profiles.py).
PERCH_LLM_DEFAULT=
# PERCH_LLM_FIT_EXPLAINER=anthropic:claude-sonnet-5-5
# OpenAI-compatible endpoint (vLLM, SGLang) for the openai adapter.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# OpenAlex API key (optional). Without it, requests share a $0.10/day budget per IP.
# Get a free key ($1/day) at https://openalex.org/settings/api. Sent as a Bearer header.
OPENALEX_API_KEY=

# GPU profile: deploy-1gpu (one 32 GB card), deploy-2gpu, or dev (8-GPU lab layout); default dev.
# Models per profile (chat, layer-2 grounder, embedder, reranker) are in perch/profiles.py,
# chosen from the S8 bench. See SPEC section 11.
PERCH_PROFILE=dev
# Ollama chat endpoint (dev: GPU 0; the demo sets 127.0.0.1:11437 in docker-compose.yml).
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Decision model servers (llama.cpp). Unset: dev ports, Clef-flash :8097, Clef :8098.
# The demo sets :8095 and :8094 in docker-compose.yml.
PERCH_CLEF_FLASH_URL=
PERCH_CLEF_URL=
# Embedder, reranker and MiniCheck over HTTP (perch.model_server). Unset: in process.
# The demo sets http://127.0.0.1:8093, because its app container has no GPU.
PERCH_MODEL_SERVER=

# perch serve: the web app is served from the same origin, so cross-origin calls are off.
# List extra origins (comma-separated) only for a front end hosted elsewhere.
PERCH_CORS_ORIGINS=

# Rate limit (perch serve): new briefs per visitor per hour on a server without accounts
# (the bench, replays). With accounts the per-account quotas in perch/user/quota.py apply.
PERCH_BRIEFS_PER_HOUR=10
# Hand-off drafts and Scout questions per visitor per hour (each runs a model).
PERCH_HANDOFF_PER_HOUR=30
PERCH_SCOUT_PER_HOUR=30
# Public base URL of the web app: the OIDC redirect URI, the cookie origin check and the CSRF
# origin check (perch/auth). Required for sign-in and guest sessions.
PERCH_PUBLIC_URL=
# Student mode: where the SYNTHETIC sample scholarships are stored, apart from the public
# store (default data/sample.db; the demo uses data/demo/sample.db). `perch samples` loads it.
PERCH_SAMPLE_DB=

# Weekly watch (S16): shelved in S23 (perch/shelved/monitor/README.md). It read this list.
PERCH_WATCH=

# --- Encryption keys (docs/ARCHITECTURE_V1.md section 6) ---
# Key store: env (dev) or kms (prod). Prod refuses env. Empty means env in dev.
PERCH_KEYSTORE=
# Dev only. Base64 of 32 random bytes; wraps the per-user data keys. Never set in prod.
# Generate one: python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
PERCH_MASTER_KEY=
# Short label stored beside every wrapped key, for example m1. Empty means m1.
PERCH_MASTER_KEY_ID=
# During a master key rotation: the previous key and its label. Remove when
# `perch keys rotate-master` reports zero rows on the old id.
PERCH_MASTER_KEY_PREV=
PERCH_MASTER_KEY_PREV_ID=
# Prod key store reference. Format depends on the KMS and is UNVERIFIED until a host is chosen.
PERCH_KMS_KEY_URI=
# Postgres URL for database perch_keys, role perch_keys. Read only by perch/keystore.py.
PERCH_KEYS_DATABASE_URL=
# --- Postgres store (v1 rebuild, ARCHITECTURE_V1 sections 1.3 and 2) ---
# Postgres URL for database `perch`. Each process uses the URL of its own role: perch_web for
# web, perch_worker for the worker. `perch db migrate` needs an admin or perch_owner URL
# (the first migration creates the roles and the pgvector extension); pass it with --dsn or
# set it here when migrating. Role passwords are set by the operator, never in a migration.
PERCH_DATABASE_URL=
# Connections in the pool, per process (also the size of the web thread pool). Default 10.
PERCH_DB_POOL_MAX=
# Tests only: a superuser URL. Postgres tests create and drop their own perch_test_a_*
# database and skip when this is unset. `make test-pg` defaults it to the local test server.
PERCH_TEST_DATABASE_URL=

# --- v1 Compose stack (deploy/compose/docker-compose.v1.yml; `make v1-up`) ---
# Superuser password of the stack Postgres. Dev only; any strong random value.
POSTGRES_PASSWORD=
# Passwords the one-shot migrate service gives the database roles. Dev only.
PERCH_OWNER_PASSWORD=
PERCH_WEB_PASSWORD=
PERCH_WORKER_PASSWORD=
PERCH_KEYS_PASSWORD=
# Keycloak bootstrap admin password (dev identity provider).
KEYCLOAK_ADMIN_PASSWORD=
# Client secret of the confidential client perch-web (Keycloak imports it, web sends it).
PERCH_OIDC_CLIENT_SECRET=
# Optional in dev: HMAC keys, see ARCHITECTURE_V1 section 1.3.
PERCH_PEPPER=
PERCH_PEPPER_GUEST=
PERCH_AUDIT_KEY=
# CPU threads per worker process, and job threads per worker process.
PERCH_TORCH_THREADS=
PERCH_WORKER_CONCURRENCY=
# Model slots per worker (default 1) and the seconds a job waits for one before failing
# (default 300); seconds before an Anthropic request times out (default 120).
PERCH_MODEL_SLOTS=
PERCH_MODEL_SLOT_TIMEOUT=
PERCH_ANTHROPIC_TIMEOUT=

# Redis URL for sessions, quotas, rate limits and the response cache (rediss:// with an ACL user in prod)
PERCH_REDIS_URL=
# Comma list of CIDRs whose X-Forwarded-For is honoured; empty means the peer address is used
PERCH_TRUSTED_PROXIES=

# Operations (S47). GPU the Compose worker reserves, by index; keep it off the GPUs other
# services use. Default 3.
PERCH_WORKER_GPU=3
# `json` writes one JSON object a line with no user data; empty keeps plain text. The v1
# Compose file defaults to json.
PERCH_LOG_FORMAT=
# Days the backup service keeps Postgres dumps (default 35, the consent text's window).
BACKUP_RETENTION_DAYS=
