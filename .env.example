# .env.example — every environment variable Perch reads, with a comment.
# Copy to .env (gitignored) and fill in. Secrets live only in .env, never in
# code, tests, fixtures, logs or commit messages. The repo will be public.

# Anthropic API key for the hosted model tier (perch/llm/ reads it from S5 on).
ANTHROPIC_API_KEY=
# Hard cap on total Anthropic spend, in USD, enforced by the adapter from its ledger
# (data/logs/anthropic_spend.jsonl). Calls are refused at the cap.
PERCH_ANTHROPIC_BUDGET_USD=100
# Model per role: <adapter>:<model>, adapters ollama, openai, anthropic, fake.
# Roles: PROFILE_SUMMARY, FIT_EXPLAINER, HANDOFF, SCOUT, DECIDE. Default: the chat model
# of PERCH_PROFILE (perch/profiles.py).
PERCH_LLM_DEFAULT=
# PERCH_LLM_FIT_EXPLAINER=anthropic:claude-sonnet-5-5
# OpenAI-compatible endpoint (vLLM, SGLang) for the openai adapter.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# OpenAlex API key (optional). Without it, requests share a $0.10/day budget per IP.
# Get a free key ($1/day) at https://openalex.org/settings/api. Sent as a Bearer header.
OPENALEX_API_KEY=

# GPU profile: deploy-1gpu (one 32 GB card), deploy-2gpu, or dev (8-GPU lab layout); default dev.
# Models per profile (chat, layer-2 grounder, embedder, reranker) are in perch/profiles.py,
# chosen from the S8 bench. See SPEC section 11.
PERCH_PROFILE=dev
# Ollama chat endpoint (dev: GPU 0; the demo sets 127.0.0.1:11437 in docker-compose.yml).
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Decision model servers (llama.cpp). Unset: dev ports, Clef-flash :8097, Clef :8098.
# The demo sets :8095 and :8094 in docker-compose.yml.
PERCH_CLEF_FLASH_URL=
PERCH_CLEF_URL=
# Embedder, reranker and MiniCheck over HTTP (perch.model_server). Unset: in process.
# The demo sets http://127.0.0.1:8093, because its app container has no GPU.
PERCH_MODEL_SERVER=

# perch serve: the web app is served from the same origin, so cross-origin calls are off.
# List extra origins (comma-separated) only for a front end hosted elsewhere.
PERCH_CORS_ORIGINS=

# Rate limit and brief reuse (perch serve). New briefs per visitor per hour; finished
# briefs with the same options are reused for this many hours (0 turns reuse off).
PERCH_BRIEFS_PER_HOUR=10
PERCH_BRIEF_REUSE_HOURS=24
# Hand-off drafts and Scout questions per visitor per hour (each runs a model).
PERCH_HANDOFF_PER_HOUR=30
PERCH_SCOUT_PER_HOUR=30

# Private mode (designed in docs/design/PRIVATE_MODE.md, built in S13; perch/privacy.py).
# PERCH_PRIVATE_MODE=1 turns it on. Model endpoints a private session may call (hosts,
# comma-separated; default loopback). Where HTTPS is decrypted: "server" (Tailscale Funnel
# decrypts on this node) or "tunnel:<provider>". The public address, when there is one.
# Who runs the server: the privacy statement names them, and private mode will not start
# without it. Keep OLLAMA_DEBUG unset and do not pass -v to llama.cpp: both may log prompts.
PERCH_PRIVATE_MODE=
PERCH_PRIVATE_ENDPOINTS=
PERCH_TLS_AT=
PERCH_PUBLIC_URL=
PERCH_PRIVATE_OPERATOR=

# Weekly watch (S16): OpenAlex author ids that `perch monitor` watches when no --author is
# given, comma-separated. The demo sets them in docker-compose.yml.
PERCH_WATCH=
